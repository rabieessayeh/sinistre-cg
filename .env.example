# Copier en .env et compléter. Ne jamais versionner .env.

# LLM (API compatible OpenAI : Groq, OpenAI, serveur local...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optionnel : autre fournisseur ou modèle pour une étape (vide = valeur LLM_* ci-dessus)
LLM_ANALYSE_BASE_URL=
LLM_ANALYSE_API_KEY=
LLM_ANALYSE_MODEL=
LLM_VERDICT_BASE_URL=
LLM_VERDICT_API_KEY=
LLM_VERDICT_MODEL=

# Optionnel : paramètres des requêtes (valeurs par défaut indiquées ;
# un effort de raisonnement vide n'envoie pas le paramètre)
# LLM_ANALYSE_MAX_TOKENS=1500
# LLM_ANALYSE_REASONING_EFFORT=low
# LLM_VERDICT_MAX_TOKENS=2500
# LLM_VERDICT_REASONING_EFFORT=medium

# Optionnel : 1 désactive le cache des réponses (.cache/llm/)
# LLM_NO_CACHE=1
